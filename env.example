# Copy this file to .env and fill in your keys. .env is never committed (see .gitignore).

# Telegram bot token from @BotFather (not needed if you only use check.py)
BOT_TOKEN=

# Solana: free key at https://dashboard.helius.dev  (required for Solana)
HELIUS_API_KEY=

# Robinhood Chain: free key at https://dev.blockscout.com  (required for Robinhood)
BLOCKSCOUT_API_KEY=

# Optional: second opinion for pump.fun tokens (paid) — https://feyn.fun
FEYN_API_KEY=

# Default mode: full (default) or fast
# CHECK_MODE=full
